# JAQA Workspace — static hosting security configuration (generated by scripts/build.mjs).
# Works on Apache and LiteSpeed (Hostinger shared/cloud hosting). See docs/HOSTINGER_DEPLOYMENT.md
# for the equivalent Nginx configuration.
#
# CSP connect-src lists ONLY sources verified for browser CORS from https://jaqa.life
# (config/cors-verification.json, 2026-09-30T10:35:10.089Z). Unverified sources are link-out only.
# script-src pins the SHA-256 hash of the inlined application script: rebuild after any JS change.

Options -Indexes
ServerSignature Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Enforce HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Never serve dotfiles other than this one's effects (e.g. .git, .env)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), clipboard-read=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'sha256-sToKv9AByawYVB4PkMmhfsXCJkXR6UDMbr8CtpOC9UE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://api.gdeltproject.org https://api.gleif.org https://api.nhtsa.gov https://api.open-meteo.com https://api.usaspending.gov https://api.weather.gov https://api.worldbank.org https://data-api.ecb.europa.eu https://data.sec.gov https://earthquake.usgs.gov https://echodata.epa.gov https://en.wikipedia.org https://geocoding-api.open-meteo.com https://overpass-api.de https://raw.githubusercontent.com https://services.nvd.nist.gov https://www.courtlistener.com https://www.federalregister.gov https://www.saferproducts.gov https://www.wikidata.org; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'none'; manifest-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By

  # HTML: never cache (always pick up the latest build and CSP hash)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

AddDefaultCharset utf-8
AddType text/html .html
