{
  "name": "jaqa-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "JAQA \u2014 global risk, finance, insurance & procurement intelligence workspace with the JAQA Eye View 3D globe and Global Monitor. Static workspace in dist/; full site served by server/jaqa-server.mjs.",
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-static-safety.mjs && node scripts/validate-links.mjs",
    "verify:dist": "node scripts/build.mjs && git diff --exit-code -- dist embed src/modules/corsConfig.js",
    "verify:cors": "node scripts/verify-cors.mjs --write",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:links:online": "node scripts/validate-links.mjs --online",
    "preview": "node scripts/preview.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "install:globe": "npm ci --prefix apps/globe",
    "build:globe": "node scripts/build-globe.mjs",
    "build:all": "node scripts/build.mjs && node scripts/build-globe.mjs",
    "start": "node server/jaqa-server.mjs",
    "test:monitor": "node scripts/test-monitor.mjs",
    "verify:monitor": "node scripts/verify-monitor.mjs"
  },
  "devDependencies": {},
  "license": "AGPL-3.0-or-later"
}
